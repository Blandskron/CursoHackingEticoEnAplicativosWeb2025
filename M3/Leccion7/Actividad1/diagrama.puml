@startuml
title Infraestructura de Red Segmentada con VLANs y Enrutamiento Inter-VLAN

!define RECTANGLE class

' Equipos por departamento
RECTANGLE PC_Admin {
  :Departamento: Administración;
  :VLAN 10;
  :IP: 192.168.1.10/26;
  :GW: 192.168.1.1;
}

RECTANGLE PC_Finanzas {
  :Departamento: Finanzas;
  :VLAN 20;
  :IP: 192.168.1.70/26;
  :GW: 192.168.1.65;
}

RECTANGLE PC_RRHH {
  :Departamento: RRHH;
  :VLAN 30;
  :IP: 192.168.1.135/26;
  :GW: 192.168.1.129;
}

RECTANGLE PC_IT {
  :Departamento: IT;
  :VLAN 40;
  :IP: 192.168.1.200/26;
  :GW: 192.168.1.193;
}

' Switch Gestionable
RECTANGLE Switch {
  :Switch Gestionable;
  :fa0/1-10 → VLAN 10;
  :fa0/11-20 → VLAN 20;
  :fa0/21-30 → VLAN 30;
  :fa0/31-40 → VLAN 40;
  :fa0/24 → trunk;
}

' Router con subinterfaces (Router-on-a-Stick)
RECTANGLE Router {
  :Router;
  :g0/0.10 → 192.168.1.1/26;
  :g0/0.20 → 192.168.1.65/26;
  :g0/0.30 → 192.168.1.129/26;
  :g0/0.40 → 192.168.1.193/26;
}

PC_Admin --> Switch : fa0/1
PC_Finanzas --> Switch : fa0/11
PC_RRHH --> Switch : fa0/21
PC_IT --> Switch : fa0/31

Switch --> Router : fa0/24 ↔ g0/0 (trunk)

@enduml
